# ---- Pflicht -------------------------------------------------------------
# Passwort für das Dashboard (Benutzer: admin). deploy/setup_vps.sh erzeugt es automatisch.
DASHBOARD_PASSWORD=bitte-ändern
POSTGRES_PASSWORD=bitte-ändern
# Domain für HTTPS (Caddy holt automatisch ein Let's-Encrypt-Zertifikat).
# Ohne eigene Domain funktioniert <IP-mit-Bindestrichen>.sslip.io, z. B. 203-0-113-7.sslip.io
DOMAIN=example.sslip.io

# ---- Marktdaten -----------------------------------------------------------
# live = echte Daten (Binance + Yahoo). synthetic = NUR Testdaten, Konto TEST.
MARKET_DATA_MODE=live
ENABLE_CRYPTO=true
ENABLE_STOCKS=true
CRYPTO_MIN_QUOTE_VOLUME=5000000
MAX_MARKETS_PER_CYCLE=1000
# STOCK_UNIVERSE=AAPL,MSFT,NVDA,SAP.DE,...

# ---- Zeitplan -------------------------------------------------------------
CYCLE_INTERVAL_SEC=300
MONITOR_INTERVAL_SEC=30
PERFORMANCE_INTERVAL_SEC=900

# ---- Paper-Konto & Kosten --------------------------------------------------
STARTING_CAPITAL_EUR=10000
ALLOW_SHORTS=true
CRYPTO_FEE_PCT=0.10
STOCK_FEE_PCT=0.0
STOCK_FEE_FIXED_EUR=1.0
CRYPTO_SLIPPAGE_BPS=3
STOCK_SLIPPAGE_BPS=4

# ---- Risiko ---------------------------------------------------------------
RISK_PER_TRADE_PCT=0.5
MAX_POSITION_PCT=15
MAX_GROSS_EXPOSURE_PCT=80
MAX_OPEN_POSITIONS=8
MAX_DAILY_LOSS_PCT=3
MAX_DRAWDOWN_PCT=15
MIN_REWARD_RISK=1.5
MIN_MODEL_SAMPLES=20
MIN_EXPECTED_VALUE_R=0.05
LOSS_COOLDOWN_MIN=60
AUTO_DISABLE_MIN_TRADES=20
AUTO_DISABLE_PROFIT_FACTOR=0.9

# ---- Echtgeld: bleibt AUS. Es existiert kein Codepfad für echte Orders. ----
LIVE_TRADING_ENABLED=false
# LIVE_TRADING_CONFIRMATION=
